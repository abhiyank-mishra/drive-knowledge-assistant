# Gemini API Key (Get from https://aistudio.google.com/ or Google Cloud Console)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Drive Service Account (for automatic Drive Folder reading)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Next.js Public App URL
NEXT_PUBLIC_APP_NAME="DriveMind AI"
